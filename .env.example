# Every value here is optional. These are the local defaults, so nothing needs setting to run the project.
# The services read real environment variables, not this file.

# Task 1: Data Validation
# SERVER_PORT=8081
# DB_URL=jdbc:sqlite:/path/to/removalsystem.db
# ADMIN_API_KEY=choose-a-long-random-value

# Task 3: Bus Pass
# SERVER_PORT=8082
# DB_URL=jdbc:h2:file:/path/to/buspassdb
# REMOVAL_INTEGRATION_ENABLED=true
# REMOVAL_BASE_URL=http://localhost:8081/api/records
# REMOVAL_RETRY_DELAY_MS=30000
# TICKET_SIGNING_SECRET=choose-a-long-random-value

# Task 4: Assistant
# CHATBOT_PORT=8090
# BUSPASS_BASE_URL=http://localhost:8082/api/buspass
# REMOVAL_BASE_URL=http://localhost:8081/api/records

# Web app
# WEB_PORT=5173
# RECORDS_URL=http://localhost:8081
# BUSPASS_URL=http://localhost:8082
# CHATBOT_URL=http://localhost:8090
